# Copy to .env.local for local development. In production, set these in Vercel (Project → Settings → Environment Variables).

# Public address of the site, used in link previews, the sitemap and the Matrica callback URL.
NEXT_PUBLIC_SITE_URL=https://madlads.com

# --- Login with Matrica -------------------------------------------------------
# Login buttons point to the holder area only when this is 1. Leave unset until launch.
NEXT_PUBLIC_HOLDERS_LIVE=

# From Matrica (business.matrica.io). Register this callback URL with them:
#   https://madlads.com/api/auth/callback   (and http://localhost:3000/api/auth/callback for development)
MATRICA_CLIENT_ID=
MATRICA_CLIENT_SECRET=
# Matrica's own ID for the Mad Lads collection (not the on-chain address).
MATRICA_COLLECTION_ID=

# Encrypts the login cookie. A long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# Changing it logs everyone out.
SESSION_SECRET=

# Development only: fake Matrica login with test Lads (ignored in production).
#   /api/auth/login          logs in as a holder
#   /api/auth/login?as=none  logs in with no Lad
MATRICA_MOCK=
